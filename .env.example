# Скопируйте этот файл в .env и заполните значения.

# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_API_TOKEN=123456789:AAAA-your-telegram-bot-token

# Ключ ProxyAPI (https://console.proxyapi.ru/keys)
ProxyAPI_KEY=sk-your-proxyapi-key

# Эндпоинт ProxyAPI и модель
ProxyAPI_BASE_URL=https://api.proxyapi.ru/v1
LLM_MODEL=openai/gpt-5-mini

# MCP-сервер
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Сколько последних пар сообщений бот помнит в каждом чате
HISTORY_LIMIT=10
